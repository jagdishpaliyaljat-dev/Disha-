# DISHA 20-20 — Environment Variables (example)
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`.

# Supabase (public publishable/anon keys only — safe for the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# ---------------------------------------------------------------------------
# Payment / Cashfree domain configuration
# ---------------------------------------------------------------------------
# Public HTTPS origin sent to Cashfree as the payment return URL and used as
# the hosted-checkout bridge domain for the Android app.
# MUST be a real, approved domain — localhost / capacitor:// CANNOT be
# whitelisted and will trigger:
#   "https://localhost/ is not enabled or approved..."
#
# For local development use a public HTTPS tunnel (e.g. ngrok / cloudflared),
# not http://localhost:5173.
VITE_APP_URL=https://disha-2020.vercel.app
# NEXT_PUBLIC_APP_URL is also accepted (exposed via vite.config.ts envPrefix).
# NEXT_PUBLIC_APP_URL=https://disha-2020.vercel.app

# Cashfree environment. PRODUCTION (default) or SANDBOX / TEST.
# Must match the credentials configured in the Edge Functions.
VITE_CASHFREE_ENV=PRODUCTION

# Supabase Edge Function secrets (set in Supabase Dashboard > Edge Functions >
# Secrets, NOT in this browser .env file):
#   APP_URL=https://disha-2020.vercel.app
#   CASHFREE_APP_ID=...
#   CASHFREE_SECRET_KEY=...        (server-side only — never expose to browser)
#   CASHFREE_ENV=PRODUCTION
#   ALLOWED_RETURN_ORIGINS=https://disha-2020.vercel.app,https://your-custom-domain.in
#   CASHFREE_SUBSCRIPTION_PAYMENT_METHODS=upi   # optional; default upi (upi,card,enach)
#
# Subscription webhooks must be configured in the SEPARATE "Subscriptions"
# webhook tab in the Cashfree Dashboard (same URL as the payments webhook).
# See docs/CASHFREE_DOMAIN_SETUP.md and docs/CASHFREE_AUTOPAY_SETUP.md.

# Optional analytics / SEO / Crash Reporting
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GOOGLE_SITE_VERIFICATION=your-google-verification-token
# VITE_TELEGRAM_CHANNEL_URL=https://t.me/your_channel
# VITE_SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0

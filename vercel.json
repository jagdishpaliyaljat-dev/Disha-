{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/news",
      "destination": "/api"
    },
    {
      "source": "/news/(.*)",
      "destination": "/api"
    },
    {
      "source": "/topics",
      "destination": "/api"
    },
    {
      "source": "/topics/(.*)",
      "destination": "/api"
    },
    {
      "source": "/about",
      "destination": "/api"
    },
    {
      "source": "/contact",
      "destination": "/api"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api"
    },
    {
      "source": "/privacy",
      "destination": "/api"
    },
    {
      "source": "/terms-of-service",
      "destination": "/api"
    },
    {
      "source": "/terms",
      "destination": "/api"
    },
    {
      "source": "/disclaimer",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
